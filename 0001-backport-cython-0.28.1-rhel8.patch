From 5fb78ed6e79aa8d5887542facd4d3adfff7c75ef Mon Sep 17 00:00:00 2001
From: Farid CHABANE <farid-externe.chabane@edf.fr>
Date: Mon, 16 Nov 2026 09:39:00 +0100
Subject: [PATCH] Match the version of the python-Cython package from RHEL8

---
 pyproject.toml | 2 +-
 setup.py       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 5334f89..0ba0799 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -3,7 +3,7 @@ build-backend = "setuptools.build_meta"
 requires = [
     "setuptools>=59.2.0",
     "wheel>=0.37.0",
-    "Cython>=0.29.37",
+    "Cython>=0.28.1",
     "packaging>=21.3"
 ]
 
diff --git a/setup.py b/setup.py
index 7edaf66..ae76e24 100644
--- a/setup.py
+++ b/setup.py
@@ -12,7 +12,7 @@ except ImportError:
     from setuptools._vendor.packaging.version import Version
 
 TOPDIR = Path(__file__).parent
-CYTHON_VERSION_MIN = "0.29.37"  # Keep in sync with pyproject.toml
+CYTHON_VERSION_MIN = "0.28.1"  # Keep in sync with pyproject.toml
 SLURM_LIB = "libslurmfull"
 
 
-- 
2.30.2

