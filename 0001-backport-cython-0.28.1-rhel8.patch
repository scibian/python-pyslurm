From 7e0bfd74e4d6cf022a43df6c49c058765e00309d Mon Sep 17 00:00:00 2001
From: Farid CHABANE <farid-externe.chabane@edf.fr>
Date: Wed, 12 Nov 2025 19:41:20 +0100
Subject: [PATCH 1/3] Match the version of the python-Cython package from RHEL8

---
 pyproject.toml | 2 +-
 setup.py       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index d23f40c..757492f 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -3,7 +3,7 @@ build-backend = "setuptools.build_meta"
 requires = [
     "setuptools>=59.2.0",
     "wheel>=0.37.0",
-    "Cython>=0.29.37",
+    "Cython>=0.28.1",
     "packaging>=21.3"
 ]
 
diff --git a/setup.py b/setup.py
index b6e7d23..17ffba2 100644
--- a/setup.py
+++ b/setup.py
@@ -28,7 +28,7 @@ def get_version():
     raise RuntimeError("Cannot get version string.")
 
 
-CYTHON_VERSION_MIN = "0.29.37" # Keep in sync with pyproject.toml
+CYTHON_VERSION_MIN = "0.28.1" # Keep in sync with pyproject.toml
 SLURM_LIB = "libslurmfull"
 VERSION = get_version()
 SLURM_VERSION = f"{VERSION.major}.{VERSION.minor}"
-- 
2.30.2

